# Lokal ishga tushirish uchun namuna (.env ga nusxalang)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mentor
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Fayllar: local (STORAGE_DIR papkasi) yoki s3
STORAGE_BACKEND=local
# STORAGE_DIR=/var/lib/mentor-hujjatlar
# S3_BUCKET=
# S3_ENDPOINT_URL=        # R2/MinIO uchun, AWS uchun bo'sh
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

MAX_UPLOAD_MB=20
TIMEZONE=Asia/Tashkent

# Ixtiyoriy: Telegram bildirishnomalari (mentor/admin profilida telegram_chat_id bo'lsa)
BOT_TOKEN=
